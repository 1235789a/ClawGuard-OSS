---
const repo = 'github.com/1235789a/ClawGuard-OSS';
const github = `https://${repo}`;

const licenseText = 'MIT';
const licenseLink = 'https://github.com/lissy93/web-check/blob/master/LICENSE';

const aboutLink = '/check/about';
const projectName = 'MultiHub Site Check';

const authorName = 'Alicia Sykes';
const authorLink = 'https://aliciasykes.com';
const currentYear = new Date().getFullYear();
---

<footer>
  <p>
    <a href="https://multhub.top">MultiHub GEO</a> · Independent website discovery
  </p>
  <p>
    <a href={aboutLink}>{projectName}</a> is based on
    <a href="https://github.com/lissy93/web-check">Web-Check</a>, licensed under
    <a href={licenseLink}>{licenseText}</a> — © <a href={authorLink}>{authorName}</a>
    {currentYear} · <a href={github}>Source</a>
  </p>
</footer>

<style lang="scss">
  @use '@styles/global.scss' as *;
  footer {
    margin-top: 1rem;
    background: var(--primary);
    color: var(--background);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    p,
    a {
      margin: 0;
      color: var(--background);
      font-size: 1rem;
    }
    a {
      text-decoration: underline;
    }
    @include tablet-portrait-down {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
